{
  "name": "disaster-rescue-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "presentation": "node scripts/start-presentation.mjs",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --passWithNoTests",
    "seed:demo": "firebase emulators:exec --config ../firebase/firebase.demo.json --only firestore,auth --project demo-disaster-rescue \"node scripts/seed-demo.js\"",
    "demo:emulators": "firebase emulators:start --config ../firebase/firebase.demo.json --only firestore,auth --project demo-disaster-rescue",
    "test:demo-emulator": "firebase emulators:exec --config ../firebase/firebase.demo.json --only firestore,auth --project demo-disaster-rescue \"vitest run test/demo-seed.emulator.test.js\"",
    "test:submission-emulator": "firebase emulators:exec --config ${SUBMISSION_EMULATOR_CONFIG:-../firebase/firebase.demo.json} --only firestore --project demo-idem-test \"vitest run test/adapters/submission\""
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}

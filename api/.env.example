# Copy to api/.env and fill in. Never commit the real file.

PORT=3000

# Firebase Admin SDK. Either point to the service account file (kept out of git)
# or set the project id only when running against the emulator.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Cloudinary (photo uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Comma-separated origins allowed by CORS (web app dev server and deployed site)
CORS_ORIGINS=http://localhost:5173

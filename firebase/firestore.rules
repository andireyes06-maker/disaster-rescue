rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers. The users/{uid} document is the current authority for active state, role, and team.
    // Token claims alone are not trusted: a disabled, demoted, or moved account is refused at once,
    // even while its ID token still carries the old claims. Any mismatch between the token and the
    // document fails closed (the role or team reads as empty).
    function signedIn() { return request.auth != null; }
    function userRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUser() { return signedIn() && exists(userRef()); }
    function userData() { return get(userRef()).data; }
    function claimActive() { return request.auth.token.get('active', false) == true; }
    function isActive() { return claimActive() && hasUser() && userData().get('active', false) == true; }
    function role() {
      return isActive() && userData().get('role', '') == request.auth.token.get('role', '') ? userData().get('role', '') : '';
    }
    function team() {
      return isActive() && userData().get('team', '') == request.auth.token.get('team', '') ? userData().get('team', '') : '';
    }
    // The website is for administrators only (professor clarification, 2026-10-23).
    // Dispatcher and DMO accounts keep their records but cannot read staff data.
    function isStaff() { return isActive() && role() == 'admin'; }

    // Can the signed-in user see this report data?
    function canSeeReport(data) {
      return isStaff()
        || (isActive() && role() == 'resident' && data.reporterId == request.auth.uid)
        || (isActive() && role() == 'responder' && team() != '' && data.assignedTeamId == team());
    }

    // The Express API (Admin SDK) is the only writer. Clients never write.
    match /reports/{reportId} {
      allow read: if canSeeReport(resource.data);
      allow write: if false;

      match /updates/{updateId} {
        allow read: if canSeeReport(get(/databases/$(database)/documents/reports/$(reportId)).data);
        allow write: if false;
      }
    }

    match /users/{uid} {
      allow read: if isActive() && (request.auth.uid == uid || role() == 'admin');
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if isActive() && resource.data.recipientUid == request.auth.uid;
      allow write: if false;
    }

    match /teams/{id} {
      allow read: if isActive() && (role() == 'admin' || (role() == 'responder' && team() == id));
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /config/hotlines {
      allow read: if isActive();
      allow write: if false;
    }

    // Demo indicator: tells every active screen that the workspace shows sample data. Written only by the demo seed.
    match /config/demo {
      allow read: if isActive();
      allow write: if false;
    }

    match /devices/{token} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

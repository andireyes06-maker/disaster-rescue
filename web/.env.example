VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Required. The address of the API this app calls. There is no default: when this is empty the app shows a
# configuration error. Use the port the API runs on (PORT in api/.env, default 3000).
VITE_API_BASE_URL=http://localhost:3000/api

# Deployment: set this to the deployed HTTPS API address in the hosting project's
# environment, along with all four Firebase values above. Run npm run preflight:release.
# Vercel uses build:release and rejects missing, localhost, or demo configuration.

# Local emulators. Set VITE_USE_EMULATORS=true only in development. Emulator mode needs a demo-* project ID
# (for example demo-disaster-rescue), so the emulators can never touch a real project.
# Standard emulator ports are auth 9099 and firestore 8080. The demo emulator in firebase/firebase.demo.json uses
# auth 9299 and firestore 8190; set those ports when running it.
VITE_USE_EMULATORS=false
# VITE_AUTH_EMULATOR_PORT=9299
# VITE_FIRESTORE_EMULATOR_PORT=8190

# Android APK download link shown on the landing page. Leave empty to hide the button.
VITE_ANDROID_APK_URL=
